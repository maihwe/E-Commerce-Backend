# Copy this file to .env and fill in the values.
#
# Nothing in this file is a real credential, and no real
# credential should ever be committed. .env is listed in
# .gitignore for exactly that reason.

# The PostgreSQL connection string.
#
# For the user-level cluster this project was developed
# against, the shape is:
#
#   postgres://USER@localhost:5432/ecommerce?sslmode=disable
DATABASE_URL=postgres://postgres@localhost:5432/ecommerce?sslmode=disable

# The port the API listens on. Defaults to 8080.
PORT=8080

# Paystack credentials.
#
# Use test keys (they begin with sk_test_) during
# development. The secret key does two jobs: it
# authenticates calls to Paystack, and it is the key an
# incoming webhook's signature is checked against. Without
# it, the payment endpoints return an error and everything
# else keeps working.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Which origins may open the order chat WebSocket.
#
# A comma-separated list. Leave it empty during local work
# to accept any origin, but set it before this server is
# reachable from the internet: a WebSocket is not covered
# by the browser's same-origin policy, so without this
# check any website could open a socket to this server
# using a signed-in visitor's cookies.
CHAT_ALLOWED_ORIGINS=

# Where the product photographs live.
#
# The storefront is compiled into the binary, and this is
# the one thing it serves that is not: the folder is read
# at startup and served from disk, so a picture can be
# added without rebuilding anything. Name each file after
# a product's slug. See pictures/README.md.
#
# Defaults to "pictures" when this is empty. The folder
# may be absent: the shop works, it simply has no
# pictures.
PICTURES_DIR=pictures

# The model that sorts a new picture into a category.
#
# When a picture is added to the folder above, it is sent
# to this API and the product is moved into the category
# the picture suggests. The answer is checked against the
# shop's own categories, so a wrong answer can only pick
# the wrong one of them; it can never invent a category,
# and no text the model produces is ever stored.
#
# Without a key, nothing is sent and every picture keeps
# whatever category its seller gave it. Everything else
# works.
ANTHROPIC_API_KEY=

# Which model to ask, and where to ask it.
#
# Both are optional. The model defaults to a current
# Claude model; change it if you would rather trade cost
# against quality, or to move to a newer one when it
# arrives. The base URL exists so tests can point this at
# a local server, the same way PAYSTACK_BASE_URL does.
VISION_MODEL=
VISION_BASE_URL=
